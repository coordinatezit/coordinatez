# Public site URL — used for canonical URLs, sitemap.xml, robots.txt, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://coordinatez.com

# SMTP credentials used by Nodemailer to send contact-form and careers-form emails
# (including the automatic confirmation email to the visitor). For Gmail: enable
# 2-Step Verification on the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that (not your normal password) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Where form submissions are delivered. Change these to reroute submissions without a
# code change. Defaults to info@coordinatez.com if unset.
CONTACT_TO_EMAIL=coorbitz7@gmail.com
CAREERS_TO_EMAIL=coorbitz7@gmail.com

# --- Cloudflare Turnstile (optional bot protection on the Contact & Careers forms) ---
# Both forms still work (honeypot + time-trap + rate limiting) if these are left unset.
# Get keys from the Cloudflare dashboard: Turnstile > Add site. The site key is public;
# the secret key must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics & tag integrations (all optional — each only loads if its ID is set) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# --- Search engine ownership verification (meta tag method) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
